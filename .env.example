DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lydg
# Alternative groupée :
# DATABASE_URL=postgresql://user:password@host:5432/db
DB_SSL=false

# --- App ---
NODE_ENV=development
PORT=3000

# --- CORS (origines additionnelles, séparées par des virgules) ---
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# --- Schema sync ---
# Ne JAMAIS activer en production : utiliser les migrations TypeORM.
AUTO_SYNC_DB=false

# --- Frontend reset password URL ---
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
FRONTEND_URL=http://localhost:5173

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# --- Public Careers API (liveydream.com) ---
# Base URL utilisée pour les canonical URLs SEO + trackingUrl.
PUBLIC_CAREERS_CANONICAL_BASE_URL=https://liveydream.com

# --- Stockage des fichiers (documents RH, congés, documents requis) ---
# Racine sur disque, HORS du dossier servi par le serveur web : le backend
# vérifie les permissions puis streame les fichiers lui-même.
# En local, laisser vide suffit : le repli est <cwd>/storage.
# STORAGE_ROOT=
