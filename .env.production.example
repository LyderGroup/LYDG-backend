# ============================================================
# Backend LYDG — variables d'environnement de PRODUCTION (Render).
# Copie ces clés dans Render → service lydg-backend → Environment.
# NE COMMITE JAMAIS les valeurs réelles (secrets).
# ============================================================

# --- Base de données : PostgreSQL local au VPS ---
# Postgres n'ecoute que sur la boucle locale : la connexion ne sort jamais de la
# machine, donc SSL est inutile ici (et DB_CA_CERT_BASE64 sans objet).
# Extensions requises : postgis, unaccent, pgcrypto.
DATABASE_URL=postgresql://obbios:<MOT_DE_PASSE>@127.0.0.1:5432/obbios
DB_SSL=false

# --- App ---
NODE_ENV=production
AUTO_SYNC_DB=false 
CORS_ALLOWED_ORIGINS=https://<ton-app>.vercel.app
FRONTEND_URL=https://<ton-app>.vercel.app
FRONTEND_RESET_PASSWORD_URL=https://<ton-app>.vercel.app/reset-password

# --- Public Careers API (liveydream.com) ---
PUBLIC_CAREERS_CANONICAL_BASE_URL=https://liveydream.com

# --- Stockage des fichiers (documents RH, congés, documents requis) ---
# Racine sur le disque du serveur, HORS du dossier servi par Nginx : le backend
# vérifie les permissions puis streame les fichiers lui-même.
# Doit être un chemin absolu, persistant entre deux déploiements, et accessible
# en écriture par l'utilisateur qui fait tourner le service.
STORAGE_ROOT=/var/lib/obbios/uploads

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
