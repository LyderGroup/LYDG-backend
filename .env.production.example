# ============================================================
# Backend LYDG — variables d'environnement de PRODUCTION (Render).
# Copie ces clés dans Render → service lydg-backend → Environment.
# NE COMMITE JAMAIS les valeurs réelles (secrets).
# ============================================================

# --- Base de données : Supabase, Session pooler (IPv4, port 5432) ---
# Supabase → Project Settings → Database → Connection string → onglet "Session pooler" (URI).
# NE PAS utiliser le Transaction pooler (port 6543) : il casse les prepared statements de TypeORM.
DATABASE_URL=postgresql://postgres.<REF>:<MOT_DE_PASSE>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DB_SSL=true
# OPTIONNEL — SSL strict (anti-MITM) : CA Supabase (Settings → Database → SSL) encodé en base64.
# Sans lui, la connexion marche mais en rejectUnauthorized:false (un warning est loggé).
# DB_CA_CERT_BASE64=

# --- App ---
NODE_ENV=production
AUTO_SYNC_DB=false 
CORS_ALLOWED_ORIGINS=https://<ton-app>.vercel.app
FRONTEND_URL=https://<ton-app>.vercel.app
FRONTEND_RESET_PASSWORD_URL=https://<ton-app>.vercel.app/reset-password

# --- Public Careers API (liveydream.com) ---
PUBLIC_CAREERS_CANONICAL_BASE_URL=https://liveydream.com

# --- Supabase Storage (uploads : documents RH, congés, documents requis) ---
# Bucket privé ; le backend streame les fichiers (le disque Render est éphémère).
# La service_role key : Supabase → Settings → API. Secret — jamais exposé au front.
SUPABASE_URL=https://tibpnhgubzndtvrauxam.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
